# PC-1500A with both extension-RAM windows at their own max size at once
# (module: cemaxa -- preset-loader sugar for 16K@0000H + 6K@expansion-
# window, confirmed bit-for-bit identical to pc1500emu's own setce128k).
# CL/NEW0/MODE is the usual sequence to gain control of the calculator
# from a cold boot, then MEM reports free memory, which should reflect
# the added RAM. No `check` -- this is a demo preset, not a test, so the
# emulator window is left open afterward for interactive use.
model: PC-1500A
firmware: ../roms/PC-1500_A04.ROM

memory-expansion:
  - address: 0x0000
    module: cemaxa

pre-load-keys:
  - key: cl
  - type: NEW0
  - key: mode

post-load-keys:
  - type: MEM
