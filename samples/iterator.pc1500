# Stock PC-1500, no memory expansion needed: types an inline BASIC listing
# through the ROM's own line editor and runs it. No `check` -- this is a
# demo preset, not a test, so the emulator window is left open afterward
# for interactive use.
model: PC-1500
firmware: ../roms/PC-1500_A04.ROM

program:
  format: basic-text
  text: |
    10 WAIT 0
    20 FOR I = 1 TO 100
    30 PRINT I
    40 NEXT I

post-load-keys:
  - key: cl
  - key: mode
  - type: RUN
