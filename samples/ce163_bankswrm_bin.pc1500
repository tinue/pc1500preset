# PC-1500 with the CE-163 memory module (8 banks/128K -- see
# vendor/pc1500emu's own README for how bank selection works) enabled,
# loading samples/CE1638_BANKSWRM_FIXED.bin (assembled from
# pc1500/CE-1638/CE1638_BANKSWRM_LOADER.asm, the "RM" loader variant with
# both known firmware defects fixed -- see CE1638_BANKSWRM_notes.md and
# pc1500/CE-1638/README.md) directly at 0x4100 via loadbinary, rather than
# typing a BASIC listing through the ROM's own line editor.
model: PC-1500
firmware: ../roms/PC-1500_A04.ROM

memory-expansion:
  - address: 0x0000
    module: ce163

pre-load-keys:
  - key: cl
  - type: NEW0

program:
  path: CE1638_BANKSWRM_FIXED.bin
  format: binary
  address: 0x4100

post-load-keys:
  - key: mode
  - type: CALL&4100
  - type: PEEK&D4
  - key: mode
  - type: NEW&104
  - type: 10 PRINT "7"
  - key: mode
