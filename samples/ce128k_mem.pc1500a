# PC-1500A with the CE-128K module (both extension-RAM windows at their
# own max size at once) enabled. CL/NEW0/MODE is the usual sequence to
# gain control of the calculator from a cold boot, then MEM reports free
# memory, which should reflect the added RAM. No `check` -- this is a demo
# preset, not a test, so the emulator window is left open afterward for
# interactive use.
model: PC-1500A
firmware: ../roms/PC-1500_A04.ROM

memory-expansion:
  - address: 0x0000
    module: ce128k

pre-load-keys:
  - key: cl
  - type: NEW0
  - key: mode

post-load-keys:
  - type: MEM
